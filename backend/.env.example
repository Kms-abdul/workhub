# Copy this file to .env and fill in your own values.

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=worktracker
DB_USER=root
DB_PASSWORD=

# Long random text, at least 32 characters. Used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First admin user, created by seed.py (password at least 8 characters)
ADMIN_EMAIL=admin@workhub.local
ADMIN_PASSWORD=
